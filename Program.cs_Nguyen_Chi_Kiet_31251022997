using System;

public class Student
{
    private string name;
    private double score;
    private static int totalStudents = 0;

    public Student(string name, double score)
    {
        this.name = name;
        this.score = score;
        totalStudents++;
    }

    // TODO: write instance methods here
    public string GetName()
    {
        return this.name;
    }

    public double GetScore()
    {
        return this.score;
    }

    public bool IsPassed()
    {
        return this.score >= 5.0;
    }

    public string GetClassification()
    {
        if (this.score >= 8.0)
            return "Excellent";
        else if (this.score >= 6.5)
            return "Good";
        else if (this.score >= 5.0)
            return "Average";
        else
            return "Weak";
    }

    // TODO: write static methods here
    public static int GetTotalStudents()
    {
        return totalStudents;
    }
    public static Student TopStudent(Student[] students)
    {
        Student topStudent = students[0];

        for (int i = 1; i < students.Length; i++)
        {
            if (students[i].score > topStudent.score)
            {
                topStudent = students[i];
            }
        }

        return topStudent;
    }

    public static double AverageScore(Student[] students)
    {
        double sum = 0;

        foreach (Student student in students)
        {
            sum += student.score;
        }

        return sum / students.Length;
    }
}

class Program
{
    static void Main(string[] args)
    {
        // Create array of Student objects
        Student s1 = new Student("Nguyen Ngan Khanh", 9.0);
        Student s2 = new Student("Pham Hao Quang", 7.0);
        Student s3 = new Student("Phuong Nguyen", 5.0);
        Student s4 = new Student("Chu Minh Thuy", 4.0);
        Student s5 = new Student("Tu Bat Tưng", 5.0);
        Student[] students = { s1, s2, s3, s4, s5 };
        foreach (Student student in students)
        {
            Console.WriteLine("Ten: " + student.GetName());
            Console.WriteLine("Diem: " + student.GetScore());
            Console.WriteLine("Dau: " + student.IsPassed());
            Console.WriteLine("Loai: " + student.GetClassification());
            Console.WriteLine("-------------------------");
        }
        // Call static method
        Console.WriteLine("Total students: " + Student.GetTotalStudents());
        Student topStudent = Student.TopStudent(students);
        Console.WriteLine();
        Console.WriteLine("Top student:" + topStudent.GetName());
        Console.WriteLine();
        double averageScore = Student.AverageScore(students);
        Console.WriteLine("Class average score: " + averageScore);
    }
}